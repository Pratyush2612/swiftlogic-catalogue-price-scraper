DATABASE_URL=sqlite:///./pricewatch.db
# Postgres (Render / production):
# DATABASE_URL=postgresql+psycopg2://user:pass@host:5432/pricewatch

DROP_ALERT_PCT=5
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_FROM=alerts@swiftlogic.local
ALERT_TO=ops@brand.example

# playwright | beautifulsoup
SCRAPER_ENGINE=beautifulsoup

# 0 = empty watchlist, add real URLs in the UI
DEMO_SEED=0
# scrape every N hours (0 disables)
SCHEDULE_HOURS=24
# optional dashboard password (Bearer token or ?token=)
APP_PASSWORD=
